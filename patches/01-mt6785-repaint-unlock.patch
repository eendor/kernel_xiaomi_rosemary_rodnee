From 52d499acd40b5c9911ca6b503e11790e465e0d6d Mon Sep 17 00:00:00 2001
From: Firmank123 <firmankediri123@gmail.com>
Date: Mon, 9 Nov 2026 04:20:52 +0700
Subject: [PATCH] video: mt6785: Unlock the repaint queue on allocation failure

When no recycled repaint job is available, trigger_repaint() allocates
one while holding repaint_queue_lock. An allocation failure returns
with the mutex still held, blocking subsequent repaint requests and
the display HAL's dequeue path.

Release the mutex before reporting the failed allocation. No job has
been inserted on that path, so there is nothing to wake or undo.

Assisted-by: GPT-6.1-Sol
---
 drivers/misc/mediatek/video/mt6785/videox/mtk_disp_mgr.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/misc/mediatek/video/mt6785/videox/mtk_disp_mgr.c b/drivers/misc/mediatek/video/mt6785/videox/mtk_disp_mgr.c
index 4ea2be76b04b..4b55b04af5b3 100644
--- a/drivers/misc/mediatek/video/mt6785/videox/mtk_disp_mgr.c
+++ b/drivers/misc/mediatek/video/mt6785/videox/mtk_disp_mgr.c
@@ -1478,6 +1478,7 @@ void trigger_repaint(int type)
 			repaint_job = kzalloc(sizeof(struct repaint_job_t),
 				GFP_KERNEL);
 			if (IS_ERR_OR_NULL(repaint_job)) {
+				mutex_unlock(&repaint_queue_lock);
 				disp_aee_print("allocate repaint_job_t fail\n");
 				return;
 			}
